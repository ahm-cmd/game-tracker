# Copy to .env and fill in. Node 20.6+ reads it directly:
#   node --env-file=.env sync.js
# .env is gitignored. Never commit real values.

# PSN session token. Log in at playstation.com, then open
# https://ca.account.sony.com/api/v1/ssocookie and copy the "npsso" value.
# Expires roughly every 2 months — you will need to refresh it.
NPSSO=

# The long ID in your sheet's URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEET_ID=

# Entire contents of the service-account JSON key file, on one line.
GOOGLE_SERVICE_ACCOUNT_KEY=

# --- Optional -----------------------------------------------------------
# Name of the tab to write to (default: Games)
# SHEET_TAB=Games

# Layout, in pixels
# COVER_W=150       # Cover column width
# GAME_W=150        # Game column width
# PLATFORM_W=25     # Platform column width
# ROW_HEIGHT=150    # Height of each game's row
# HEADER_HEIGHT=25  # Height of the header row

# Set to 0 to skip HowLongToBeat lookups (faster runs)
# HLTB_ENABLED=1
